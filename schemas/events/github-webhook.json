{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHubWebhookEvent",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": { "type": "string", "enum": ["push","pull_request","issues","release","workflow_run"] },
    "payload": { "type": "object" },
    "repository": { "type": "string" },
    "commit": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
