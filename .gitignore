# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
coverage/
*.tsbuildinfo

# Environment & Secrets - NEVER commit real keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
/playwright-report/
/test-results/
.nyc_output/

# Benchmarks & Certification artifacts (keep latest, ignore temp)
certification/reports/*.tmp
benchmarks/**/results.tmp

# Docker
.docker/

# Misc
.cache/
.tmp/
temp/

# Certification scratch output (generated in CI, never committed)
.fingerprint-out/
certification-from-ci/
fingerprint-reproducibility/
certification/reports/raw/
certification/reports/coverage/
certification/reports/audit-all.json
certification/reports/audit-prod.json

# Per-commit attestation records accumulate: each certification writes <sha>.json, so
# committing them guarantees a stale record for every previous commit. They are
# regenerated by CI and uploaded as workflow artifacts. `latest.json` stays tracked
# because it is overwritten in place rather than accumulated.
certification/attestations/*.json
!certification/attestations/latest.json
