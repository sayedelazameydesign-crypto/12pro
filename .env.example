# AGI-OS / Agent OS - Environment Template
# Copy to .env and fill with real secrets - NEVER commit .env

# ===== Budget & Governance =====
MAX_SPEND=0
MAX_TOKENS_PER_MISSION=100000
MAX_TOOL_CALLS=50
MISSION_TIMEOUT_MS=300000

# ===== LLM Providers =====
# At least one required
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# ===== Ollama (Local) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# ===== Runtime =====
NODE_ENV=development
LOG_LEVEL=info
RUNTIME_MODE=sandbox # sandbox | host | docker
SANDBOX_TIMEOUT=60000

# ===== Services =====
API_PORT=3000
API_HOST=0.0.0.0
WORKER_CONCURRENCY=4
SCHEDULER_CRON_ENABLED=true

# ===== Database & Memory =====
DATABASE_URL=postgresql://user:pass@localhost:5432/agi_os
REDIS_URL=redis://localhost:6379
VECTOR_DB_URL=http://localhost:6333
MEMORY_BACKEND=vector # vector | redis | memory

# ===== Browser =====
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# ===== Observability =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
TRACING_ENABLED=true

# ===== Security =====
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-32-chars
SECRET_SCANNING=true

# ===== GitHub Integration =====
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
