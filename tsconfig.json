    { "path": "./packages/memory" },
    { "path": "./packages/skills" },
    { "path": "./packages/tools" },
    { "path": "./packages/browser" },
    { "path": "./packages/sandbox" },
    { "path": "./packages/governance" },
    { "path": "./packages/security" },
    { "path": "./packages/providers" },
    { "path": "./packages/identity" },
    { "path": "./packages/autonomy" },
    { "path": "./packages/observability" },
    { "path": "./packages/evaluation" },
    { "path": "./packages/cognition" },
    { "path": "./packages/memory-fabric" },
    { "path": "./packages/mcp" },
    { "path": "./packages/connectors" },
    { "path": "./packages/os" },
    { "path": "./packages/evidence" },
    { "path": "./packages/mission-ledger" },
    { "path": "./packages/skills-registry" },
