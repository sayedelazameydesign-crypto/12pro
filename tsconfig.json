{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@agi-system/kernel": ["packages/kernel/src"],
      "@agi-system/agent-core": ["packages/agent-core/src"],
      "@agi-system/runtime": ["packages/runtime/src"],
      "@agi-system/planner": ["packages/planner/src"],
      "@agi-system/orchestrator": ["packages/orchestrator/src"],
      "@agi-system/swarm": ["packages/swarm/src"],
      "@agi-system/memory": ["packages/memory/src"],
      "@agi-system/skills": ["packages/skills/src"],
      "@agi-system/tools": ["packages/tools/src"],
      "@agi-system/browser": ["packages/browser/src"],
      "@agi-system/sandbox": ["packages/sandbox/src"],
      "@agi-system/governance": ["packages/governance/src"],
      "@agi-system/security": ["packages/security/src"],
      "@agi-system/providers": ["packages/providers/src"],
      "@agi-system/observability": ["packages/observability/src"],
      "@agi-system/evaluation": ["packages/evaluation/src"]
    }
  },
  "references": [
    { "path": "./packages/kernel" },
    { "path": "./packages/agent-core" },
    { "path": "./packages/runtime" },
    { "path": "./packages/planner" },
    { "path": "./packages/orchestrator" },
    { "path": "./packages/swarm" },
    { "path": "./packages/memory" },
    { "path": "./packages/skills" },
    { "path": "./packages/tools" },
    { "path": "./packages/browser" },
    { "path": "./packages/sandbox" },
    { "path": "./packages/governance" },
    { "path": "./packages/security" },
    { "path": "./packages/providers" },
    { "path": "./packages/observability" },
    { "path": "./packages/evaluation" },
    { "path": "./apps/api" },
    { "path": "./apps/web" },
    { "path": "./apps/agent-ui" },
    { "path": "./services/api-server" },
    { "path": "./services/worker" },
    { "path": "./services/scheduler" },
    { "path": "./services/webhook" }
  ],
  "include": ["packages/**/src", "apps/**/src", "services/**/src", "tests", "benchmarks", "scripts", "evaluations", "schemas"],
  "exclude": ["node_modules", "dist", "**/dist"]
}
